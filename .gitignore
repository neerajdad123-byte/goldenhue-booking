# The database is data, not source.
outputs/demo/goldenhue.db
outputs/demo/goldenhue.db-wal
outputs/demo/goldenhue.db-shm
# Any SQLite file anywhere, including the ones the tests create in scratch
# directories. This has been gotten wrong three times; a glob cannot be dodged by
# inventing a new test path.
*.db
*.db-wal
*.db-shm

# Browser profiles created by the automated checks. This is hundreds of megabytes
# of Chrome state and must never enter the repository.
work/chrome-*/

# Staging directories for the published preview. They are their own git repos and
# must never be nested inside this one.
work/ghpages*/

# The fresh-checkout simulation: it copies the repository into here to prove a
# deploy works, and is removed again afterwards. If a run is interrupted it can be
# left behind, and it is a copy of the repo, so it must never be committed.
work/deploy-sim/

# Scratch output: logs and captured browser state.
work/*.log
work/*.err.log
*.log

# Housekeeping.
node_modules/
.DS_Store
Thumbs.db
